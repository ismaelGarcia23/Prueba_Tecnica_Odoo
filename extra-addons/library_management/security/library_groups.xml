<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_library_customer" model="res.groups">
            <field name="name">Biblioteca / Socio</field>
        </record>

        <record id="group_library_librarian" model="res.groups">
            <field name="name">Biblioteca / Bibliotecario</field>
            <field name="implied_ids" eval="[(4, ref('group_library_customer'))]"/>
        </record>

        <record id="library_loan_portal_rule" model="ir.rule">
            <field name="name">Mis Préstamos</field>
            <field name="model_id" ref="model_library_loan"/>
            <field name="groups" eval="[(4, ref('group_library_customer'))]"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        </record>

        <record id="library_loan_librarian_rule" model="ir.rule">
            <field name="name">Todos los Préstamos</field>
            <field name="model_id" ref="model_library_loan"/>
            <field name="groups" eval="[(4, ref('group_library_librarian'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>