<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_loan_form" model="ir.ui.view">
        <field name="name">library.loan.form</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm_loan" string="Confirmar Préstamo" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_return_book" string="Devolver Libro" type="object" invisible="state != 'loaned'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="book_id"/>
                        <field name="loan_date"/>
                        <field name="return_date"/>
                        <field name="actual_return_date" invisible="state != 'returned'"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_library_loan" model="ir.actions.act_window">
        <field name="name">Préstamos</field>
        <field name="res_model">library.loan</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_library_root" name="Biblioteca" sequence="10"/>
    <menuitem id="menu_library_loans" name="Préstamos" parent="menu_library_root" action="action_library_loan"/>
</odoo>