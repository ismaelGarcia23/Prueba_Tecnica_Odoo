<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_loan_tree" model="ir.ui.view">
        <field name="name">library.loan.list</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <list string="Préstamos" 
                  decoration-info="state == 'draft'" 
                  decoration-warning="state == 'loaned'" 
                  decoration-success="state == 'returned'" 
                  decoration-danger="state == 'overdue'">
                <field name="partner_id"/>
                <field name="book_id"/>
                <field name="loan_date"/>
                <field name="return_date" widget="remaining_days"/>
                <field name="state" 
                       widget="badge" 
                       decoration-info="state == 'draft'" 
                       decoration-warning="state == 'loaned'" 
                       decoration-success="state == 'returned'" 
                       decoration-danger="state == 'overdue'"/>
            </list>
        </field>
    </record>

    <record id="view_loan_form" model="ir.ui.view">
        <field name="name">library.loan.form</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm_loan" 
                            string="Confirmar Préstamo" 
                            type="object" 
                            class="oe_highlight" 
                            invisible="state != 'draft'"
                            icon="fa-check"/>
                    <button name="action_return_book" 
                            string="Devolver Libro" 
                            type="object" 
                            invisible="state != 'loaned'"
                            icon="fa-undo"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,loaned,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="partner_id" placeholder="Seleccionar Socio..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Detalles del Libro">
                            <field name="book_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Fechas de Control">
                            <field name="loan_date"/>
                            <field name="return_date"/>
                            <field name="actual_return_date" invisible="state != 'returned'"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_library_loan" model="ir.actions.act_window">
        <field name="name">Préstamos</field>
        <field name="res_model">library.loan</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_library_root" name="Biblioteca" sequence="10" web_icon="base,static/description/icon.png"/>
    <menuitem id="menu_library_loans" name="Préstamos" parent="menu_library_root" action="action_library_loan"/>
</odoo>